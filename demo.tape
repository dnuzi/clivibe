Output assets/demo.gif

Set Shell "cmd"
Set FontSize 15
Set Width 960
Set Height 580
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Framerate 25
Set PlaybackSpeed 1.0

Type "node bin/clivibe.js --version"
Sleep 200ms
Enter
Sleep 1.5s

Type "node bin/clivibe.js gradient ""CLIVIBE TERMINAL UI ENGINE"" --preset synthwave"
Sleep 200ms
Enter
Sleep 2.5s

Type "node bin/clivibe.js spark 5,12,18,9,24,35,42,28,50,65,72,58,80,95"
Sleep 200ms
Enter
Sleep 2s

Type "node bin/clivibe.js chart 10,25,18,34,55,42,60,35"
Sleep 200ms
Enter
Sleep 2.5s

Type "node bin/clivibe.js box ""All systems operational"" --title ""CLIVIBE v1.2"" --style double"
Sleep 200ms
Enter
Sleep 2s

Type "node bin/clivibe.js doctor"
Sleep 200ms
Enter
Sleep 3s
