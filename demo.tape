Output assets/demo.gif

Set Shell "cmd"
Set FontSize 14
Set Width 960
Set Height 620
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 25ms
Set Framerate 25
Set PlaybackSpeed 1.25

Type "node bin/clivibe.js --version"
Sleep 150ms
Enter
Sleep 1.2s

Type "node bin/clivibe.js gradient ""CLIVIBE DEVELOPER COCKPIT"" --preset synthwave"
Sleep 150ms
Enter
Sleep 1.6s

Type "node bin/clivibe.js spark 5,12,18,9,24,35,42,28,50,65,72,58,80,95"
Sleep 150ms
Enter
Sleep 1.4s

Type "node bin/clivibe.js chart 10,25,18,34,55,42,60,35"
Sleep 150ms
Enter
Sleep 1.6s

Type "node bin/clivibe.js box ""All systems operational"" --title ""CLIVIBE v1.3"" --style double"
Sleep 150ms
Enter
Sleep 1.4s

Type "node bin/clivibe.js wtf ""Error: listen EADDRINUSE :3000"""
Sleep 150ms
Enter
Sleep 1.8s

Type "node bin/clivibe.js sysinfo"
Sleep 150ms
Enter
Sleep 1.8s

Type "node bin/clivibe.js json package.json name"
Sleep 150ms
Enter
Sleep 1.4s

Type "node bin/clivibe.js cron ""*/15 * * * *"""
Sleep 150ms
Enter
Sleep 1.4s

Type "node bin/clivibe.js hash clivibe"
Sleep 150ms
Enter
Sleep 1.6s

Type "node bin/clivibe.js doctor"
Sleep 150ms
Enter
Sleep 2.5s
