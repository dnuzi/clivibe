{
  "name": "clivibe",
  "version": "1.3.0",
  "description": "Zero-dependency terminal color, gradient, and UI toolkit for Node.js.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui": "./src/ui/index.js",
    "./colors": "./src/ui/colors.js",
    "./image": "./src/ui/image.js",
    "./box": "./src/ui/box.js",
    "./chart": "./src/ui/chart.js",
    "./progress": "./src/ui/progress.js",
    "./widgets": "./src/ui/widgets.js",
    "./tasks": "./src/ui/tasks.js",
    "./diff": "./src/commands/diff.js",
    "./json": "./src/commands/json.js",
    "./serve": "./src/commands/serve.js"
  },
  "bin": {
    "clivibe": "./bin/clivibe.js",
    "cv": "./bin/clivibe.js"
  },
  "scripts": {
    "start": "node bin/clivibe.js",
    "test": "node --test tests/cli.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnuzi/clivibe.git"
  },
  "keywords": [
    "clivibe",
    "terminal",
    "cli",
    "tui",
    "terminal-ui",
    "colors",
    "gradient",
    "ansi",
    "zero-dependencies",
    "developer-tools",
    "diff",
    "serve",
    "json",
    "sysinfo",
    "git",
    "docker",
    "log-viewer",
    "productivity",
    "npx"
  ],
  "author": "DanuZz <danuz.dev@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dnuzi/clivibe/issues"
  },
  "homepage": "https://github.com/dnuzi/clivibe#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
