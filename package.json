{
  "name": "clivibe",
  "version": "1.1.0",
  "description": "⚡ The Zero-Dependency Developer Cockpit, CLI Suite & Terminal UI Engine. Chalk, gradient-string, terminal-image, boxen, asciichart & progress in pure native Node.js.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui": "./src/ui/index.js",
    "./colors": "./src/ui/colors.js",
    "./image": "./src/ui/image.js",
    "./box": "./src/ui/box.js",
    "./chart": "./src/ui/chart.js",
    "./progress": "./src/ui/progress.js"
  },
  "bin": {
    "clivibe": "./bin/clivibe.js",
    "cv": "./bin/clivibe.js"
  },
  "scripts": {
    "start": "node bin/clivibe.js",
    "test": "node --test tests/cli.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnuzi/clivibe.git"
  },
  "keywords": [
    "clivibe",
    "zero-dependencies",
    "cli",
    "chalk",
    "gradient-string",
    "terminal-image",
    "boxen",
    "asciichart",
    "cli-progress",
    "developer-tools",
    "tui",
    "terminal",
    "terminal-ui",
    "git",
    "docker",
    "error-explainer",
    "log-viewer",
    "swiss-army-knife",
    "productivity",
    "npx"
  ],
  "author": "DanuZz <danuz.dev@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dnuzi/clivibe/issues"
  },
  "homepage": "https://github.com/dnuzi/clivibe#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
